      "type": "object",
      "required": [
        "id",
        "type",
        "skill",
        "promptZh",
        "instruction",
        "options",
        "sourceType",
        "reviewStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "multiple-choice"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
