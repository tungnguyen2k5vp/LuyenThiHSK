{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe"
  },
  "environment": {
    "locale": "vi-VN",
    "timezone": "Asia/Bangkok",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "reduced_motion": "no-preference"
  },
  "start_url": {
    "url": "http://127.0.0.1:4173/"
  },
  "actions": [
    {
      "step_id": "loaded",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".journey-visual svg"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "animation_complete",
      "action": "wait_for_timeout",
      "duration_ms": 1700
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "accessibility"
    ],
    "at_end": [
      "url",
      "accessibility",
      "screenshot"
    ],
    "events": [
      "console"
    ]
  }
}