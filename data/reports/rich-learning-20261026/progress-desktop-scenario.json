{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe"
  },
  "environment": {
    "locale": "vi-VN",
    "timezone": "Asia/Bangkok",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "reduced_motion": "no-preference"
  },
  "start_url": {
    "url": "http://127.0.0.1:4173/?view=progress"
  },
  "storage": {
    "local_storage": [
      {
        "origin": "http://127.0.0.1:4173/",
        "entries": [
          {
            "name": "hsk-study-data-v1",
            "value": {
              "source": "literal",
              "value": "{\"schemaVersion\":3,\"sessions\":[],\"attempts\":[{\"id\":\"rich-today-a\",\"examId\":\"exam-hsk3-general-demo\",\"mode\":\"practice\",\"answers\":{},\"flaggedQuestionIds\":[],\"selfRatings\":{},\"startedAt\":\"2026-10-26T16:25:09.577Z\",\"finishedAt\":\"2026-10-26T16:27:09.577Z\",\"durationSeconds\":120},{\"id\":\"rich-today-b\",\"examId\":\"exam-hsk3-general-demo\",\"mode\":\"practice\",\"answers\":{},\"flaggedQuestionIds\":[],\"selfRatings\":{},\"startedAt\":\"2026-10-26T16:23:09.577Z\",\"finishedAt\":\"2026-10-26T16:27:09.577Z\",\"durationSeconds\":240},{\"id\":\"rich-yesterday\",\"examId\":\"exam-hsk3-general-demo\",\"mode\":\"practice\",\"answers\":{},\"flaggedQuestionIds\":[],\"selfRatings\":{},\"startedAt\":\"2026-10-25T16:25:39.577Z\",\"finishedAt\":\"2026-10-25T16:27:09.577Z\",\"durationSeconds\":90},{\"id\":\"rich-older\",\"examId\":\"exam-hsk3-general-demo\",\"mode\":\"practice\",\"answers\":{},\"flaggedQuestionIds\":[],\"selfRatings\":{},\"startedAt\":\"2026-10-16T16:26:09.577Z\",\"finishedAt\":\"2026-10-16T16:27:09.577Z\",\"durationSeconds\":60}],\"reviewItems\":[],\"vocabulary\":{},\"wordEntries\":[]}"
            }
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "step_id": "chart_loaded",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".interactive-bars"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "today_counts",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-day-detail:has-text(\"2 lượt làm · 6 phút\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "count_metric",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-chart-controls button:has-text(\"Lượt làm\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "fourteen_days",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-chart-controls button:has-text(\"14 ngày\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "fourteen_bars",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".interactive-bars[data-range=\"14\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "yesterday_keyboard",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": ".interactive-bars button >> nth=12"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "yesterday_detail",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-day-detail:has-text(\"1 lượt làm · 1.5 phút\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "chart_settled",
      "action": "wait_for_timeout",
      "duration_ms": 800
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "accessibility",
      "storage"
    ],
    "at_end": [
      "url",
      "accessibility",
      "storage",
      "screenshot"
    ],
    "events": [
      "console"
    ]
  }
}