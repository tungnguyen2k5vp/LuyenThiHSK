{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe"
  },
  "environment": {
    "locale": "vi-VN",
    "timezone": "Asia/Bangkok",
    "viewport": {
      "width": 390,
      "height": 844
    },
    "reduced_motion": "reduce"
  },
  "start_url": {
    "url": "http://127.0.0.1:4173/?view=progress"
  },
  "storage": {
    "local_storage": []
  },
  "actions": [
    {
      "step_id": "chart_loaded",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".interactive-bars"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "range_empty",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-chart-controls button:has-text(\"14 ngày\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "metric_empty",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-chart-controls button:has-text(\"Lượt làm\")"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "first_day_keyboard",
      "action": "press",
      "locator": {
        "kind": "css",
        "selector": ".interactive-bars button >> nth=0"
      },
      "key": "Enter",
      "timeout_ms": 10000
    },
    {
      "step_id": "empty_detail",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".dashboard-day-detail:has-text(\"0 lượt làm · 0 phút\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "empty_settled",
      "action": "wait_for_timeout",
      "duration_ms": 800
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "accessibility",
      "storage"
    ],
    "at_end": [
      "url",
      "accessibility",
      "storage",
      "screenshot"
    ],
    "events": [
      "console"
    ]
  }
}